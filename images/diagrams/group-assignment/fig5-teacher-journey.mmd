graph TD
    subgraph "Human-in-the-Loop: Three Levels"
        direction TB
    end

    subgraph "Level 1: KG Construction - Pre-Query"
        L1A["Government PDFs<br/>and circulars"] --> L1B["LLM extracts<br/>draft KG triples"]
